---
const navItems = [
	{ label: "Услуги", href: "#services" },
	{ label: "Резултати", href: "#results" },
	{ label: "Процес", href: "#process" },
	{ label: "Отзиви", href: "#testimonials" },
	{ label: "Контакт", href: "#contact" },
];
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-ink-900/80 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<a href="#top" class="text-lg font-bold tracking-tight text-white">
			Валентин Арнаутски
		</a>

		<nav class="hidden items-center gap-8 md:flex">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class="text-sm font-medium text-gray-300 transition hover:text-white"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<a
			href="#contact"
			class="rounded-full bg-accent-500 px-5 py-2 text-sm font-semibold text-ink-900 transition hover:bg-accent-400"
		>
			Запази консултация
		</a>
	</div>
</header>
