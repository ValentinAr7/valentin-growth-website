---
const navItems = [
	{ label: "Услуги", href: "#services" },
	{ label: "Резултати", href: "#results" },
	{ label: "Контакт", href: "#contact" },
];
---

<header class="absolute inset-x-0 top-0 z-50">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-5 sm:px-6 sm:py-6">
		<span class="text-sm font-semibold text-white sm:text-base">
			Валентин Арнаутски
		</span>

		<nav class="hidden items-center gap-2 sm:flex">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class="rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm font-medium text-gray-200 backdrop-blur transition hover:border-white/20 hover:bg-white/[0.08]"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<a
			href="#contact"
			class="rounded-full border border-white/10 bg-white/[0.06] px-4 py-2 text-xs font-semibold text-white backdrop-blur sm:hidden"
		>
			Контакт
		</a>
	</div>
</header>
