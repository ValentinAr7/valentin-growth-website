---
const steps = [
	{
		number: "01",
		title: "Одит и диагностика",
		description: "Преглеждам акаунти, магазин и данни, за да открия къде се губят пари.",
	},
	{
		number: "02",
		title: "Стратегия и план",
		description: "Изготвям конкретен план с приоритети — какво правим първо и защо.",
	},
	{
		number: "03",
		title: "Изпълнение и тестове",
		description: "Пускаме, измерваме и оптимизираме въз основа на реални данни, не усещания.",
	},
	{
		number: "04",
		title: "Мащабиране",
		description: "Удвояваме работещото и изграждаме предвидим, повтарящ се растеж.",
	},
];
---

<section id="process" class="border-t border-white/5 py-24">
	<div class="mx-auto max-w-6xl px-6">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold text-white sm:text-4xl">Как работим заедно</h2>
			<p class="mt-4 text-gray-400">Ясен процес, без изненади и без губене на време.</p>
		</div>

		<div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				steps.map((step) => (
					<div class="relative rounded-2xl border border-white/10 bg-white/[0.03] p-6">
						<span class="text-4xl font-extrabold text-white/10">{step.number}</span>
						<h3 class="mt-3 text-lg font-semibold text-white">{step.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-gray-400">{step.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
