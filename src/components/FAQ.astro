---
// TODO: допълни с реални въпроси, които клиентите питат най-често.
const faqs = [
	{
		question: "С какъв тип бизнеси работиш?",
		answer:
			"Основно с e-commerce магазини и D2C брандове, които вече имат продажби и искат предвидим растеж.",
	},
	{
		question: "Какъв е минималният рекламен бюджет?",
		answer: "Обсъждаме го индивидуално според целите — на консултацията ще уточним детайлите.",
	},
	{
		question: "За колко време се виждат резултати?",
		answer:
			"Първите сигнали обикновено се виждат в рамките на 2-4 седмици, устойчив растеж — в рамките на 2-3 месеца.",
	},
];
---

<section id="faq" class="border-t border-white/5 py-24">
	<div class="mx-auto max-w-3xl px-6">
		<h2 class="text-center text-3xl font-bold text-white sm:text-4xl">Често задавани въпроси</h2>

		<div class="mt-12 space-y-4">
			{
				faqs.map((faq) => (
					<details class="group rounded-2xl border border-white/10 bg-white/[0.03] p-6">
						<summary class="cursor-pointer list-none font-semibold text-white marker:hidden">
							<span class="flex items-center justify-between">
								{faq.question}
								<span class="ml-4 text-gray-500 transition group-open:rotate-45">+</span>
							</span>
						</summary>
						<p class="mt-3 text-sm leading-relaxed text-gray-400">{faq.answer}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
