---
// TODO: замени с реални отзиви от клиенти (с тяхно съгласие).
const testimonials = [
	{
		quote:
			"Валентин влезе директно в детайлите на бизнеса ни и промените, които предложи, се отразиха на продажбите още първия месец.",
		name: "Плейсхолдър клиент",
		role: "Собственик на онлайн магазин",
	},
	{
		quote:
			"Комуникацията беше кристално ясна, а отчетите — разбираеми дори за нас, които не сме маркетолози.",
		name: "Плейсхолдър клиент",
		role: "E-commerce мениджър",
	},
];
---

<section id="testimonials" class="border-t border-white/5 py-24">
	<div class="mx-auto max-w-6xl px-6">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold text-white sm:text-4xl">Какво казват клиентите</h2>
		</div>

		<div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
			{
				testimonials.map((t) => (
					<figure class="rounded-2xl border border-white/10 bg-white/[0.03] p-8">
						<blockquote class="text-gray-200">“{t.quote}”</blockquote>
						<figcaption class="mt-6 text-sm">
							<span class="font-semibold text-white">{t.name}</span>
							<span class="text-gray-500"> — {t.role}</span>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
