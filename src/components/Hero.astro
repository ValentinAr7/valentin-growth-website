---
// TODO: замени /images/profile.jpg с реална снимка (виж public/images/README.txt).
const stack = [
	{ name: "Shopify", slug: "shopify", color: "95BF47" },
	{ name: "WooCommerce", slug: "woocommerce", color: "96588A" },
	{ name: "Meta Ads", slug: "meta", color: "0081FB" },
	{ name: "TikTok", slug: "tiktok", color: "FFFFFF" },
	{ name: "Instagram", slug: "instagram", color: "E4405F" },
	{ name: "Google Ads", slug: "googleads", color: "FFFFFF" },
	{ name: "ChatGPT", slug: "openai", color: "FFFFFF" },
	{ name: "Claude", slug: "claude", color: "D97757" },
];

// Детерминиран seed, за да е еднакво звездното поле при всеки билд.
function mulberry32(seed: number) {
	return function () {
		seed |= 0;
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}
const rand = mulberry32(42);
const stars = Array.from({ length: 70 }, () => ({
	top: rand() * 100,
	left: rand() * 100,
	size: rand() * 1.6 + 0.6,
	opacity: rand() * 0.6 + 0.2,
	delay: rand() * 4,
	duration: rand() * 3 + 2,
}));

// Диамантена рамка около ореола — равномерно разположени "диаманти" по обиколката.
const diamondCount = 20;
const diamonds = Array.from({ length: diamondCount }, (_, i) => {
	const angle = (i / diamondCount) * Math.PI * 2;
	const big = i % 3 === 0;
	return {
		angle,
		top: 50 + Math.sin(angle) * 50,
		left: 50 + Math.cos(angle) * 50,
		size: big ? 13 : 7,
		delay: (i * 0.17) % 3.5,
	};
});
---

<section
	id="hero-section"
	class="relative isolate overflow-hidden pt-32 pb-24"
	style="--mx: 50%; --my: 30%;"
>
	<!-- фон: звезди + плавен градиент, следващ мишката -->
	<div class="pointer-events-none absolute inset-0">
		<div class="absolute inset-0 bg-ink-900"></div>
		<div
			id="hero-spotlight"
			class="absolute inset-0 transition-[background] duration-300"
			style="background: radial-gradient(600px circle at var(--mx) var(--my), rgba(168,85,247,0.18), transparent 60%);"
		>
		</div>
		{
			stars.map((star) => (
				<span
					class="absolute rounded-full bg-white"
					style={`top:${star.top}%; left:${star.left}%; width:${star.size}px; height:${star.size}px; opacity:${star.opacity}; animation: twinkle ${star.duration}s ease-in-out ${star.delay}s infinite; --star-opacity:${star.opacity};`}
				/>
			))
		}
	</div>

	<div class="relative mx-auto max-w-6xl px-6 text-center">
		<!-- орбита със снимка -->
		<div class="mx-auto mb-10 [perspective:1000px]" style="width: min(380px, 70vw);">
			<div id="hero-orb" class="relative aspect-square w-full transition-transform duration-150 ease-out">
				<div
					id="hero-orb-glow"
					class="pointer-events-none absolute -inset-8 rounded-full bg-gradient-to-br from-violet-500/50 via-fuchsia-500/30 to-violet-500/50 blur-3xl transition-transform duration-150 ease-out"
				>
				</div>

				<!-- диамантена рамка -->
				<div class="pointer-events-none absolute -inset-5 sm:-inset-6" id="hero-diamond-ring">
					{
						diamonds.map((d) => (
							<span
								class="diamond absolute rounded-[3px] bg-gradient-to-br from-violet-200 via-violet-400 to-fuchsia-500"
								data-angle={d.angle}
								style={`top:${d.top}%; left:${d.left}%; width:${d.size}px; height:${d.size}px; animation-delay:${d.delay}s;`}
							/>
						))
					}
				</div>

				<div class="relative h-full w-full overflow-hidden rounded-full border border-violet-400/20 bg-ink-800 shadow-[0_0_90px_-15px_rgba(168,85,247,0.55)]">
					<img
						src="/images/profile-image.png"
						alt="Валентин Арнаутски"
						class="h-full w-full object-cover"
						onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
					/>
					<div class="hidden h-full w-full items-center justify-center text-sm text-gray-500">
						[ снимка на Валентин ]
					</div>
					<!-- виньетка за по-драматичен, тъмен изглед -->
					<div class="pointer-events-none absolute inset-0 rounded-full bg-[radial-gradient(circle_at_50%_40%,transparent_35%,rgba(0,0,0,0.55)_100%)]">
					</div>
				</div>
			</div>
		</div>

		<!-- стек от инструменти -->
		<div class="mx-auto mb-10 flex max-w-2xl flex-wrap items-center justify-center gap-3">
			{
				stack.map((tool) => (
					<div
						class="group flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] p-2.5 backdrop-blur transition hover:-translate-y-1 hover:border-white/20 hover:bg-white/[0.08] sm:h-14 sm:w-14"
						title={tool.name}
					>
						<img
							src={`https://cdn.simpleicons.org/${tool.slug}/${tool.color}`}
							alt={tool.name}
							class="h-full w-full object-contain"
							loading="lazy"
						/>
					</div>
				))
			}
		</div>

		<h1 class="mx-auto max-w-3xl text-3xl leading-tight font-semibold text-white sm:text-4xl md:text-5xl">
			Здравей, аз съм Валентин <span aria-hidden="true">🚀</span> Изграждам
			<span class="font-extrabold">предвидим E-commerce растеж</span>
			<span> и </span>
			<span class="font-serif text-2xl italic text-gray-300 sm:text-3xl md:text-4xl">
				маркетинг, който продава.
			</span>
		</h1>

		<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a
				href="#contact"
				class="w-full rounded-full bg-accent-500 px-8 py-3 text-base font-semibold text-ink-900 transition hover:bg-accent-400 sm:w-auto"
			>
				Запази безплатна консултация
			</a>
			<a
				href="#results"
				class="w-full rounded-full border border-white/15 px-8 py-3 text-base font-semibold text-white transition hover:bg-white/5 sm:w-auto"
			>
				Виж резултатите
			</a>
		</div>

		<div class="mt-8 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 text-sm text-gray-300">
			<span class="relative flex h-2 w-2">
				<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-400 opacity-75"></span>
				<span class="relative inline-flex h-2 w-2 rounded-full bg-accent-500"></span>
			</span>
			Отворен за нови проекти
		</div>
	</div>
</section>

<script>
	function initHeroEffects() {
		const heroSection = document.getElementById("hero-section") as HTMLElement | null;
		const orb = document.getElementById("hero-orb") as HTMLElement | null;
		const glow = document.getElementById("hero-orb-glow") as HTMLElement | null;
		const diamonds = document.querySelectorAll<HTMLElement>("#hero-diamond-ring .diamond");
		if (!heroSection || !orb || !glow) return;

		const prefersFinePointer = window.matchMedia("(pointer: fine)").matches;
		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (!prefersFinePointer || prefersReducedMotion) return;

		const maxTilt = 10;

		function handleMove(e: MouseEvent) {
			const heroRect = heroSection!.getBoundingClientRect();
			heroSection!.style.setProperty("--mx", `${e.clientX - heroRect.left}px`);
			heroSection!.style.setProperty("--my", `${e.clientY - heroRect.top}px`);

			const orbRect = orb!.getBoundingClientRect();
			const cx = orbRect.left + orbRect.width / 2;
			const cy = orbRect.top + orbRect.height / 2;
			const dx = e.clientX - cx;
			const dy = e.clientY - cy;

			const cursorAngle = Math.atan2(dy, dx);
			const radius = orbRect.width / 2;
			const gx = Math.cos(cursorAngle) * radius;
			const gy = Math.sin(cursorAngle) * radius;
			glow!.style.transform = `translate(${gx * 0.6}px, ${gy * 0.6}px)`;

			diamonds.forEach((el) => {
				const dAngle = parseFloat(el.dataset.angle ?? "0");
				let diff = Math.abs(cursorAngle - dAngle);
				if (diff > Math.PI) diff = Math.PI * 2 - diff;
				const intensity = Math.max(0, 1 - diff / (Math.PI / 2));
				el.style.opacity = String(0.35 + 0.65 * intensity);
				el.style.setProperty(
					"transform",
					`translate(-50%, -50%) rotate(45deg) scale(${1 + 0.7 * intensity})`,
				);
				el.style.boxShadow = `0 0 ${6 + 20 * intensity}px ${2 + 4 * intensity}px rgba(192,132,252,${0.4 + 0.5 * intensity})`;
			});

			const distance = Math.hypot(dx, dy);
			const influence = Math.max(0, 1 - distance / (radius * 4));
			const tiltX = Math.max(-1, Math.min(1, -dy / 400)) * maxTilt * influence;
			const tiltY = Math.max(-1, Math.min(1, dx / 400)) * maxTilt * influence;
			orb!.style.transform = `rotateX(${tiltX}deg) rotateY(${tiltY}deg)`;
		}

		function handleLeave() {
			orb!.style.transform = "rotateX(0deg) rotateY(0deg)";
		}

		window.addEventListener("mousemove", handleMove, { passive: true });
		heroSection.addEventListener("mouseleave", handleLeave);
	}

	initHeroEffects();
	document.addEventListener("astro:page-load", initHeroEffects);
</script>

<style>
	.diamond {
		transform: translate(-50%, -50%) rotate(45deg);
		opacity: 0.55;
		box-shadow: 0 0 10px 2px rgba(192, 132, 252, 0.45);
		transition:
			opacity 0.15s ease-out,
			transform 0.15s ease-out,
			box-shadow 0.15s ease-out;
		animation: diamond-pulse 3.5s ease-in-out infinite;
	}

	@keyframes diamond-pulse {
		0%,
		100% {
			filter: brightness(1);
		}
		50% {
			filter: brightness(1.4);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.diamond {
			animation: none;
		}
	}
</style>
