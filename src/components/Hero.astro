---
// Плочки с инструменти, "прилепени" от двете страни на снимката (само desktop —
// на мобилно композицията е прекалено тясна за странично плаващи елементи,
// затова стекът се вижда в ToolMarquee секцията под hero-то).
const leftTools = [
	{ name: "Meta", slug: "meta", color: "0081FB", top: 10, left: -6, rotate: -6 },
	{ name: "TikTok", slug: "tiktok", color: "FFFFFF", top: 34, left: -10, rotate: 5 },
	{ name: "ChatGPT", textFallback: "GPT", fallbackBg: "#10a37f", top: 60, left: -8, rotate: -4 },
	{ name: "Claude", slug: "claude", color: "D97757", top: 85, left: -3, rotate: 6 },
];

const rightTools = [
	{ name: "Shopify", slug: "shopify", color: "95BF47", top: 6, left: 100, rotate: 5 },
	{ name: "WooCommerce", slug: "woocommerce", color: "96588A", top: 27, left: 107, rotate: -6 },
	{ name: "Google Analytics", slug: "googleanalytics", color: "E37400", top: 49, left: 100, rotate: 4 },
	{ name: "Instagram", slug: "instagram", color: "E4405F", top: 71, left: 107, rotate: -5 },
	{ name: "Klaviyo", textFallback: "K", fallbackBg: "#374151", top: 91, left: 100, rotate: 6 },
];

const allTools = [...leftTools, ...rightTools].map((tool, i) => ({
	...tool,
	speed: (i % 2 === 0 ? 1 : -1) * (7 + (i % 4) * 3),
}));
---

<section id="hero-section" class="relative isolate overflow-hidden pt-28 pb-20 sm:pt-32 sm:pb-24">
	<!-- фон: тъмна база + меки, размазани цветни петна (aurora) -->
	<div class="pointer-events-none absolute inset-0">
		<div class="absolute inset-0 bg-ink-900"></div>
		<div
			class="absolute top-[-10%] left-1/2 h-[420px] w-[420px] -translate-x-[70%] rounded-full bg-brand-600/25 blur-[110px] sm:h-[560px] sm:w-[560px]"
		>
		</div>
		<div
			class="absolute top-[5%] right-1/2 h-[360px] w-[360px] translate-x-[60%] rounded-full bg-cyan-500/10 blur-[110px] sm:h-[480px] sm:w-[480px]"
		>
		</div>
		<div
			id="hero-spotlight"
			class="absolute inset-0"
			style="background: radial-gradient(560px circle at var(--mx, 50%) var(--my, 20%), rgba(34,211,238,0.10), transparent 60%);"
		>
		</div>
	</div>

	<div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-6 md:grid-cols-[1fr_1.05fr] md:gap-10 md:px-10">
		<!-- послание (ляво на desktop) -->
		<div class="order-2 text-center md:order-1 md:text-left">
			<div class="inline-flex flex-col items-center md:items-start">
				<p class="text-xs font-semibold tracking-[0.25em] text-gray-400 uppercase">
					Маркетинг & E-commerce
				</p>
				<span class="mt-2 h-[3px] w-10 rounded-full bg-cyan-400"></span>
			</div>

			<h1 class="mt-5 text-4xl leading-[1.05] font-black tracking-tight text-white sm:text-5xl md:text-6xl">
				<span class="block">Твоят бизнес.</span>
				<span class="block">Моят опит.</span>
				<span class="block text-cyan-400">Ясен план за растеж.</span>
			</h1>

			<p class="mx-auto mt-5 max-w-md text-base text-gray-400 sm:text-lg md:mx-0">
				Аз съм Валентин — маркетинг и e-commerce консултант. Работя директно с теб
				върху рекламите, офертите и клиентското преживяване, за да превърнем идеите
				за развитие в конкретни действия.
			</p>

			<div class="mt-8 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row md:justify-start">
				<a
					href="#contact"
					class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-cyan-400 px-7 py-3 text-base font-semibold text-ink-900 transition hover:bg-cyan-300 sm:w-auto"
				>
					Нека поговорим <span aria-hidden="true">↗</span>
				</a>
				<a
					href="#services"
					class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-white/20 px-7 py-3 text-base font-semibold text-white transition hover:bg-white/5 sm:w-auto"
				>
					Виж моя подход
				</a>
			</div>
		</div>

		<!-- снимка + плочки с инструменти (дясно на desktop) -->
		<div class="order-1 md:order-2">
			<div class="relative mx-auto [perspective:1200px]" style="width: min(420px, 78vw);">
				<div
					id="hero-photo"
					class="relative h-[380px] w-full overflow-hidden rounded-[2rem] border border-white/10 shadow-2xl transition-transform duration-150 ease-out sm:h-[440px] md:h-[520px]"
				>
					<img
						src="/images/profile-image.png"
						alt="Валентин Арнаутски"
						class="h-full w-full object-cover"
						onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
					/>
					<div class="hidden h-full w-full items-center justify-center text-sm text-gray-500">
						[ снимка на Валентин ]
					</div>
					<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-900/70 via-transparent to-cyan-500/10">
					</div>
					<div class="pointer-events-none absolute inset-0 shadow-[inset_0_0_60px_20px_rgba(0,0,0,0.55)]">
					</div>
				</div>

				<!-- плочки с инструменти, само на desktop -->
				{
					allTools.map((tool) => (
						<div
							class="tool-tile absolute hidden flex-col items-center gap-1.5 rounded-2xl border border-white/10 bg-ink-800/90 px-3 py-2.5 shadow-lg backdrop-blur md:flex"
							data-speed={tool.speed}
							data-rotate={tool.rotate}
							style={`top:${tool.top}%; left:${tool.left}%; transform: translate(-50%, -50%) rotate(${tool.rotate}deg);`}
						>
							{tool.textFallback ? (
								<span
									class="flex h-6 w-6 items-center justify-center rounded-md border border-white/10 text-[8px] font-extrabold text-white"
									style={`background:${tool.fallbackBg};`}
								>
									{tool.textFallback}
								</span>
							) : (
								<img
									src={`https://cdn.simpleicons.org/${tool.slug}/${tool.color}`}
									alt=""
									class="h-6 w-6 object-contain"
									loading="lazy"
								/>
							)}
							<span class="text-[10px] font-medium whitespace-nowrap text-gray-300">
								{tool.name}
							</span>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	function initHeroEffects() {
		const heroSection = document.getElementById("hero-section") as HTMLElement | null;
		const photo = document.getElementById("hero-photo") as HTMLElement | null;
		const tiles = Array.from(document.querySelectorAll<HTMLElement>(".tool-tile"));
		if (!heroSection || !photo) return;

		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		// --- скрол: плочките леко "плават" нагоре/надолу спрямо позицията на hero-то ---
		let ticking = false;
		function updateParallax() {
			ticking = false;
			const rect = heroSection!.getBoundingClientRect();
			const progress = Math.max(-1, Math.min(1, -rect.top / (rect.height || 1)));
			tiles.forEach((tile) => {
				const speed = parseFloat(tile.dataset.speed ?? "10");
				const rotate = parseFloat(tile.dataset.rotate ?? "0");
				const offset = prefersReducedMotion ? 0 : progress * speed;
				tile.style.transform = `translate(-50%, -50%) rotate(${rotate}deg) translateY(${offset}px)`;
			});
		}
		function onScroll() {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(updateParallax);
			}
		}
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", updateParallax);
		updateParallax();

		// --- мишка: лек 3D наклон на снимката + мек spotlight на фона ---
		const prefersFinePointer = window.matchMedia("(pointer: fine)").matches;
		if (!prefersFinePointer || prefersReducedMotion) return;

		const maxTilt = 5;

		function handleMove(e: MouseEvent) {
			const heroRect = heroSection!.getBoundingClientRect();
			heroSection!.style.setProperty("--mx", `${e.clientX - heroRect.left}px`);
			heroSection!.style.setProperty("--my", `${e.clientY - heroRect.top}px`);

			const photoRect = photo!.getBoundingClientRect();
			const cx = photoRect.left + photoRect.width / 2;
			const cy = photoRect.top + photoRect.height / 2;
			const dx = e.clientX - cx;
			const dy = e.clientY - cy;

			const distance = Math.hypot(dx, dy);
			const influence = Math.max(0, 1 - distance / (photoRect.width * 3));
			const tiltX = Math.max(-1, Math.min(1, -dy / 500)) * maxTilt * influence;
			const tiltY = Math.max(-1, Math.min(1, dx / 500)) * maxTilt * influence;
			photo!.style.transform = `rotateX(${tiltX}deg) rotateY(${tiltY}deg)`;
		}

		function handleLeave() {
			photo!.style.transform = "rotateX(0deg) rotateY(0deg)";
		}

		window.addEventListener("mousemove", handleMove, { passive: true });
		heroSection.addEventListener("mouseleave", handleLeave);
	}

	initHeroEffects();
	document.addEventListener("astro:page-load", initHeroEffects);
</script>
