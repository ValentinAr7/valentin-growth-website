---
// TODO: замени плейсхолдър копито с реални цифри/резултати, когато имаме данни.
const stats = [
	{ value: "50+", label: "e-commerce проекта" },
	{ value: "€2M+", label: "управляван рекламен бюджет" },
	{ value: "3.4x", label: "среден ръст на ROAS" },
];
---

<section id="top" class="relative overflow-hidden pt-20 pb-24">
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-brand-700/30 via-transparent to-transparent"
	>
	</div>

	<div class="relative mx-auto max-w-6xl px-6 text-center">
		<p class="mx-auto mb-6 w-fit rounded-full border border-white/10 bg-white/5 px-4 py-1 text-sm font-medium text-brand-200">
			Marketing & E-commerce Growth Expert
		</p>

		<h1 class="mx-auto max-w-4xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl md:text-6xl">
			Превръщам e-commerce бизнеси в
			<span class="bg-gradient-to-r from-brand-400 to-accent-400 bg-clip-text text-transparent">
				предвидими машини за растеж
			</span>
		</h1>

		<p class="mx-auto mt-6 max-w-2xl text-lg text-gray-300">
			Стратегия, платена реклама и оптимизация на конверсиите за онлайн магазини,
			които искат измерим резултат — не догадки.
		</p>

		<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a
				href="#contact"
				class="w-full rounded-full bg-accent-500 px-8 py-3 text-base font-semibold text-ink-900 transition hover:bg-accent-400 sm:w-auto"
			>
				Запази безплатна консултация
			</a>
			<a
				href="#results"
				class="w-full rounded-full border border-white/15 px-8 py-3 text-base font-semibold text-white transition hover:bg-white/5 sm:w-auto"
			>
				Виж резултатите
			</a>
		</div>

		<dl class="mx-auto mt-16 grid max-w-3xl grid-cols-1 gap-8 border-t border-white/10 pt-10 sm:grid-cols-3">
			{
				stats.map((stat) => (
					<div>
						<dt class="text-3xl font-extrabold text-white">{stat.value}</dt>
						<dd class="mt-1 text-sm text-gray-400">{stat.label}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
