---
// TODO: замени с реални case studies и цифри, след като ги съберем.
const cases = [
	{
		client: "Онлайн магазин за козметика",
		metric: "+142%",
		description: "ръст на приходите от платена реклама за 4 месеца",
	},
	{
		client: "Бранд за спортно оборудване",
		metric: "-38%",
		description: "намаление на цената за придобиване на клиент (CPA)",
	},
	{
		client: "D2C магазин за аксесоари",
		metric: "3.9x",
		description: "възвръщаемост на рекламния бюджет (ROAS)",
	},
];
---

<section id="results" class="border-t border-white/5 py-24">
	<div class="mx-auto max-w-6xl px-6">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold text-white sm:text-4xl">Резултати</h2>
			<p class="mt-4 text-gray-400">
				Плейсхолдър примери — ще заменим с реални case studies и разрешение от клиенти.
			</p>
		</div>

		<div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-3">
			{
				cases.map((item) => (
					<div class="rounded-2xl border border-white/10 bg-white/[0.03] p-8 text-center">
						<div class="text-4xl font-extrabold text-accent-400">{item.metric}</div>
						<p class="mt-3 text-sm text-gray-300">{item.description}</p>
						<p class="mt-4 text-xs font-medium uppercase tracking-wide text-gray-500">
							{item.client}
						</p>
					</div>
				))
			}
		</div>
	</div>
</section>
