---
// TODO: прецизирай списъка с реалните услуги, които предлагаш.
const services = [
	{
		title: "Платена реклама (Meta & Google)",
		description:
			"Изграждане и оптимизация на рекламни акаунти, фокусирани върху ROAS, а не само трафик.",
		icon: "📈",
	},
	{
		title: "E-commerce стратегия",
		description:
			"Пълен growth план — от позициониране и оферта до канали за придобиване на клиенти.",
		icon: "🧭",
	},
	{
		title: "CRO & оптимизация на конверсии",
		description:
			"Одит на онлайн магазина и тестове, които вдигат процента на завършените поръчки.",
		icon: "🛒",
	},
	{
		title: "Изграждане на продуктови фунии",
		description:
			"Фунии от реклама до плащане, проектирани да превръщат вниманието в приходи.",
		icon: "⚙️",
	},
];
---

<section id="services" class="border-t border-white/5 py-24">
	<div class="mx-auto max-w-6xl px-6">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-3xl font-bold text-white sm:text-4xl">С какво помагам</h2>
			<p class="mt-4 text-gray-400">
				Конкретни услуги, насочени към едно нещо — измерим ръст на приходите.
			</p>
		</div>

		<div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2">
			{
				services.map((service) => (
					<div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-brand-500/40 hover:bg-white/[0.05]">
						<div class="text-3xl">{service.icon}</div>
						<h3 class="mt-4 text-lg font-semibold text-white">{service.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-gray-400">{service.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
